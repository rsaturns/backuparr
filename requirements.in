# Backuparr's own dependencies. requirements.txt pins these and everything
# they pull in to exact versions with their hashes (#230). After changing
# this file, regenerate it in the image's Python:
#   docker run --rm -v "$PWD":/src -w /src python:3.15-alpine sh -c \
#     'pip install -q pip-tools && pip-compile -q --generate-hashes --strip-extras --no-emit-index-url requirements.in'
# Dependabot updates the pins weekly.
